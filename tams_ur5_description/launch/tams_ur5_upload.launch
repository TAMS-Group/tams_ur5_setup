<?xml version="1.0"?>
<launch>
	 <arg name="joint_limits_parameters_file" default="$(find tams_ur5_description)/config/joint_ranges/default.yaml"/>
	 <param name="robot_description" command="$(find xacro)/xacro '$(find tams_ur5_description)/urdf/arm.urdf.xacro' joint_limits_parameters_file:=$(arg joint_limits_parameters_file)" />
</launch>
